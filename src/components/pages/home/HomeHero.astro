---
// [custom] 首页 Hero：问候、座右铭、简介、主操作按钮 + 原创终端风格 SVG 插画（无角色素材）
import { Icon } from "astro-icon/components";
import { profileConfig } from "@/config";
import { homeConfig } from "@/config/homeConfig";
import { url } from "@/utils/url-utils";

const { hero } = homeConfig;
const greeting = hero.greeting.replace("{name}", profileConfig.name);
---

<section class="home-hero card-base onload-animation" aria-labelledby="home-hero-title">
	<div class="home-hero-text">
		<p class="home-hero-kicker">
			<Icon name="material-symbols:terminal-rounded" aria-hidden="true" />
			<span>~/ welcome</span>
		</p>
		<!-- 页面已有隐藏的 h1（站点标题，见 [...page].astro），这里用 h2 避免重复 h1 -->
		<h2 id="home-hero-title">{greeting}</h2>
		<p class="home-hero-motto" lang="zh-CN">{hero.motto}</p>
		<p class="home-hero-motto-en" lang="en">{hero.mottoEn}</p>
		<p class="home-hero-intro">{hero.intro}</p>
		<div class="home-hero-actions">
			{
				hero.actions.map((action) => (
					<a
						href={url(action.href)}
						class:list={["home-hero-btn", { "is-primary": action.primary }]}
					>
						<Icon name={action.icon} aria-hidden="true" />
						<span>{action.label}</span>
					</a>
				))
			}
		</div>
	</div>

	<!-- 原创装饰插画：终端窗口 + 几何图形，纯 SVG，颜色取主题变量 -->
	<div class="home-hero-art" aria-hidden="true">
		<svg viewBox="0 0 320 240" xmlns="http://www.w3.org/2000/svg" focusable="false">
			<circle class="art-orb art-orb-a" cx="262" cy="44" r="34"></circle>
			<circle class="art-orb art-orb-b" cx="46" cy="204" r="22"></circle>
			<rect class="art-diamond" x="268" y="168" width="22" height="22" rx="4" transform="rotate(45 279 179)"></rect>

			<g class="art-window">
				<rect x="34" y="40" width="248" height="164" rx="14" class="art-frame"></rect>
				<path d="M34 54a14 14 0 0 1 14-14h220a14 14 0 0 1 14 14v12H34z" class="art-bar"></path>
				<circle cx="54" cy="53" r="4.5" class="art-dot art-dot-1"></circle>
				<circle cx="70" cy="53" r="4.5" class="art-dot art-dot-2"></circle>
				<circle cx="86" cy="53" r="4.5" class="art-dot art-dot-3"></circle>

				<text x="52" y="94" class="art-code art-prompt">$</text>
				<rect x="66" y="86" width="96" height="9" rx="4.5" class="art-line art-line-teal"></rect>
				<rect x="52" y="108" width="140" height="9" rx="4.5" class="art-line"></rect>
				<rect x="68" y="126" width="72" height="9" rx="4.5" class="art-line art-line-lavender"></rect>
				<rect x="148" y="126" width="56" height="9" rx="4.5" class="art-line"></rect>
				<rect x="68" y="144" width="112" height="9" rx="4.5" class="art-line art-line-blue"></rect>
				<rect x="52" y="162" width="88" height="9" rx="4.5" class="art-line"></rect>
				<text x="52" y="190" class="art-code art-prompt">$</text>
				<rect x="66" y="181" width="9" height="12" rx="2" class="art-cursor"></rect>
			</g>
		</svg>
	</div>
</section>

<style>
	.home-hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
		align-items: center;
		gap: 1.5rem;
		padding: 2rem 2.25rem;
		/* 亮色浅青底块，暗色下为极淡青色叠加 */
		background:
			radial-gradient(120% 140% at 100% 0%, var(--brand-soft) 0%, transparent 60%),
			var(--card-bg);
	}

	.home-hero-kicker {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		margin: 0 0 0.75rem;
		padding: 0.2rem 0.65rem;
		border-radius: var(--radius-full);
		font-family: var(--font-code, ui-monospace, monospace);
		font-size: 0.8rem;
		color: var(--btn-content);
		background: var(--btn-regular-bg);
	}

	h2 {
		margin: 0;
		font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
		line-height: 1.2;
		font-weight: 800;
		color: var(--deep-text);
	}

	.home-hero-motto {
		margin: 0.75rem 0 0;
		font-size: 1.125rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		background: var(--brand-gradient);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.home-hero-motto-en {
		margin: 0.25rem 0 0;
		font-size: 0.875rem;
		font-style: italic;
		color: var(--content-meta);
	}

	.home-hero-intro {
		margin: 1rem 0 0;
		max-width: 36rem;
		line-height: 1.7;
		color: var(--brand-text-muted);
	}

	.home-hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
		margin-top: 1.5rem;
	}

	.home-hero-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		min-height: 2.5rem;
		padding: 0 1rem;
		border-radius: var(--radius-xl);
		border: 1px solid var(--line-color);
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--deep-text);
		background: var(--card-bg);
		transition:
			background-color var(--duration-normal) var(--ease-standard),
			border-color var(--duration-normal) var(--ease-standard),
			color var(--duration-normal) var(--ease-standard),
			transform var(--duration-normal) var(--ease-standard);
	}

	.home-hero-btn :global(svg) {
		font-size: 1.15rem;
	}

	.home-hero-btn:hover {
		border-color: var(--primary);
		color: var(--primary);
		transform: translateY(-1px);
	}

	.home-hero-btn.is-primary {
		border-color: transparent;
		color: var(--btn-content);
		background: var(--btn-regular-bg);
	}

	.home-hero-btn.is-primary:hover {
		background: var(--btn-regular-bg-hover);
	}

	.home-hero-btn:active {
		transform: none;
	}

	/* ===== 插画 ===== */
	.home-hero-art svg {
		display: block;
		width: 100%;
		max-width: 22rem;
		height: auto;
		margin-inline: auto;
	}

	.art-orb-a {
		fill: var(--brand-teal);
		opacity: 0.22;
	}

	.art-orb-b {
		fill: var(--brand-lavender);
		opacity: 0.25;
	}

	.art-diamond {
		fill: none;
		stroke: var(--brand-blue);
		stroke-width: 2.5;
		opacity: 0.6;
	}

	.art-frame {
		fill: var(--codeblock-bg);
		stroke: var(--line-color);
	}

	.art-bar {
		fill: var(--codeblock-topbar-bg);
	}

	.art-dot-1 {
		fill: #f7768e;
	}

	.art-dot-2 {
		fill: #e0af68;
	}

	.art-dot-3 {
		fill: #9ece6a;
	}

	.art-code {
		font-family: var(--font-code, ui-monospace, monospace);
		font-size: 13px;
		font-weight: 700;
	}

	.art-prompt {
		fill: var(--brand-teal);
	}

	.art-line {
		fill: rgb(169 177 214 / 0.28);
	}

	.art-line-teal {
		fill: var(--brand-teal);
		opacity: 0.85;
	}

	.art-line-lavender {
		fill: var(--brand-lavender);
		opacity: 0.85;
	}

	.art-line-blue {
		fill: var(--brand-blue);
		opacity: 0.85;
	}

	.art-cursor {
		fill: var(--brand-teal);
		animation: home-hero-blink 1.1s steps(1) infinite;
	}

	@keyframes home-hero-blink {
		50% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.art-cursor {
			animation: none;
		}

		.home-hero-btn,
		.home-hero-btn:hover {
			transition: none;
			transform: none;
		}
	}

	/* ===== 响应式 ===== */
	@media (max-width: 1023px) {
		.home-hero {
			grid-template-columns: minmax(0, 1fr);
			padding: 1.75rem 1.5rem;
		}

		.home-hero-art {
			order: -1;
		}

		.home-hero-art svg {
			max-width: 15rem;
		}
	}

	@media (max-width: 480px) {
		.home-hero {
			padding: 1.25rem 1rem;
		}

		.home-hero-art {
			display: none;
		}
	}
</style>
