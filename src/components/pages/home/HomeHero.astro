---
// [custom] 首页自我介绍卡片：问候、简介、主操作按钮 + 原创樱花 SVG 装饰（无角色素材）
// 首屏的大标题与座右铭由全屏壁纸横幅显示（backgroundWallpaper.common.homeText），这里不重复
import { Icon } from "astro-icon/components";
import { profileConfig } from "@/config";
import { homeConfig } from "@/config/homeConfig";
import { url } from "@/utils/url-utils";

const { hero } = homeConfig;
// 问候语拆成「名字前 / 名字后」两段，名字单独上色
const [before = "", ...rest] = hero.greeting.split("{name}");
const hasName = rest.length > 0;
const greetingParts = [before, rest.join(profileConfig.name)];

// 五瓣樱花：每片花瓣绕中心旋转 72°
const petalAngles = [0, 72, 144, 216, 288];
---

<section class="home-hero card-base onload-animation" aria-labelledby="home-hero-title">
	<div class="home-hero-text">
		<p class="home-hero-kicker">
			<Icon name="material-symbols:local-florist-outline-rounded" aria-hidden="true" />
			<span>Welcome</span>
		</p>
		<!-- 页面已有隐藏的 h1（站点标题，见 [...page].astro），这里用 h2 避免重复 h1 -->
		<h2 id="home-hero-title">
			{greetingParts[0]}{hasName && <span class="home-hero-name">{profileConfig.name}</span>}{greetingParts[1]}
		</h2>
		<p class="home-hero-intro">{hero.intro}</p>
		<div class="home-hero-actions">
			{
				hero.actions.map((action) => (
					<a
						href={url(action.href)}
						class:list={["home-hero-btn", { "is-primary": action.primary }]}
					>
						<Icon name={action.icon} aria-hidden="true" />
						<span>{action.label}</span>
					</a>
				))
			}
		</div>
	</div>

	<!-- 原创装饰：三朵樱花 + 光斑，纯 SVG，颜色取主题令牌 -->
	<div class="home-hero-art" aria-hidden="true">
		<svg viewBox="0 0 280 220" xmlns="http://www.w3.org/2000/svg" focusable="false">
			<defs>
				<path id="home-petal" d="M0 0C-14 -10 -16 -32 -6 -44L0 -38L6 -44C16 -32 14 -10 0 0Z"></path>
				<g id="home-flower">
					{petalAngles.map((a) => <use href="#home-petal" transform={`rotate(${a})`} />)}
					<circle r="6" class="art-core"></circle>
				</g>
			</defs>

			<circle class="art-glow art-glow-a" cx="196" cy="70" r="58"></circle>
			<circle class="art-glow art-glow-b" cx="70" cy="160" r="40"></circle>

			<g class="art-flower art-flower-a" transform="translate(150 104) scale(1.35)">
				<use href="#home-flower" class="art-sway"></use>
			</g>
			<g class="art-flower art-flower-b" transform="translate(232 168) scale(0.8) rotate(18)">
				<use href="#home-flower"></use>
			</g>
			<g class="art-flower art-flower-c" transform="translate(56 58) scale(0.62) rotate(-12)">
				<use href="#home-flower"></use>
			</g>

			<use href="#home-petal" class="art-loose" transform="translate(96 196) rotate(120) scale(0.45)"></use>
			<use href="#home-petal" class="art-loose" transform="translate(250 34) rotate(-40) scale(0.38)"></use>
		</svg>
	</div>
</section>

<style>
	.home-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 9.5rem;
		align-items: center;
		gap: 1.5rem;
		padding: 3rem 2.75rem;
		background-image: radial-gradient(
			120% 140% at 100% 0%,
			var(--brand-soft) 0%,
			transparent 60%
		);
	}

	.home-hero-kicker {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		margin: 0 0 1rem;
		padding: 0.25rem 0.8rem;
		border-radius: var(--radius-full);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--btn-content);
		background: var(--btn-regular-bg);
	}

	h2 {
		margin: 0;
		font-size: clamp(1.875rem, 1.2rem + 2.4vw, 2.75rem);
		line-height: 1.2;
		font-weight: 800;
		color: var(--deep-text);
	}

	/* 名字用主题色；不用渐变文字，保证半透明卡片上的对比度 */
	.home-hero-name {
		color: var(--brand-rose);
	}

	.home-hero-intro {
		margin: 1.25rem 0 0;
		max-width: 38rem;
		font-size: 1.05rem;
		line-height: 1.8;
		color: var(--brand-text-muted);
	}

	.home-hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.home-hero-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.75rem;
		padding: 0 1.1rem;
		border-radius: var(--radius-full);
		border: 1px solid var(--line-color);
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--deep-text);
		background: var(--card-bg);
		transition:
			background-color var(--duration-normal) var(--ease-standard),
			border-color var(--duration-normal) var(--ease-standard),
			color var(--duration-normal) var(--ease-standard),
			transform var(--duration-normal) var(--ease-standard);
	}

	.home-hero-btn :global(svg) {
		font-size: 1.15rem;
	}

	.home-hero-btn:hover {
		border-color: var(--primary);
		color: var(--primary);
		transform: translateY(-1px);
	}

	.home-hero-btn.is-primary {
		border-color: transparent;
		color: var(--btn-content);
		background: var(--btn-regular-bg);
	}

	.home-hero-btn.is-primary:hover {
		background: var(--btn-regular-bg-hover);
	}

	.home-hero-btn:active {
		transform: none;
	}

	/* ===== 樱花装饰 ===== */
	.home-hero-art svg {
		display: block;
		width: 100%;
		max-width: 20rem;
		height: auto;
		margin-inline: auto;
		overflow: visible;
	}

	.art-glow-a {
		fill: var(--brand-pink);
		opacity: 0.18;
	}

	.art-glow-b {
		fill: var(--brand-sky);
		opacity: 0.2;
	}

	.art-flower {
		fill: var(--brand-pink);
	}

	.art-flower-b {
		fill: var(--brand-lavender);
		opacity: 0.85;
	}

	.art-flower-c {
		fill: var(--brand-rose);
		opacity: 0.7;
	}

	.art-core {
		fill: #fff5c2;
	}

	.art-loose {
		fill: var(--brand-pink);
		opacity: 0.6;
	}

	/* 花朵中心在局部坐标原点，绕原点缓慢摆动 */
	.art-sway {
		transform-origin: 0 0;
		animation: home-hero-sway 6s ease-in-out infinite alternate;
	}

	@keyframes home-hero-sway {
		to {
			transform: rotate(12deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.art-sway {
			animation: none;
		}

		.home-hero-btn,
		.home-hero-btn:hover {
			transition: none;
			transform: none;
		}
	}

	/* ===== 响应式 ===== */
	@media (max-width: 1023px) {
		.home-hero {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.5rem;
			padding: 2.25rem 2rem;
		}

		.home-hero-art {
			order: -1;
		}

		.home-hero-art svg {
			max-width: 13rem;
		}
	}

	@media (max-width: 480px) {
		.home-hero {
			padding: 1.75rem 1.25rem;
		}

		.home-hero-art {
			display: none;
		}
	}
</style>
