---
// [custom] 首页区块标题：左侧标题 + 可选的「查看全部」链接
import { Icon } from "astro-icon/components";
import { url } from "@/utils/url-utils";

interface Props {
	title: string;
	icon?: string;
	href?: string;
	linkLabel?: string;
	id?: string;
}

const { title, icon, href, linkLabel = "View all", id } = Astro.props;
---

<div class="home-section-heading">
	<h2 id={id}>
		{icon && <Icon name={icon} aria-hidden="true" />}
		<span>{title}</span>
	</h2>
	{
		href && (
			<a href={url(href)} class="home-section-link">
				{linkLabel}
				<Icon name="material-symbols:arrow-forward-rounded" aria-hidden="true" />
			</a>
		)
	}
</div>

<style>
	.home-section-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.25rem;
		padding-inline: 0.25rem;
	}

	h2 {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		/* 标题直接叠在壁纸上，用半透明玻璃底保证任何壁纸下都能看清 */
		padding: 0.45rem 1.1rem 0.45rem 0.9rem;
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-full);
		background: var(--card-bg-transparent);
		box-shadow: var(--card-shadow);
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--deep-text);
	}

	h2 :global(svg) {
		font-size: 1.25rem;
		color: var(--primary);
	}

	/* 标题前的短色条 */
	h2::before {
		content: "";
		width: 0.25rem;
		height: 1.1em;
		border-radius: var(--radius-full);
		background: var(--brand-gradient);
	}

	.home-section-link {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.35rem 0.85rem;
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-full);
		background: var(--card-bg-transparent);
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--content-meta);
		transition: color var(--duration-normal) var(--ease-standard);
	}

	.home-section-link:hover {
		color: var(--primary);
	}
</style>
